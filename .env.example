# ==========================================
# AlgoVault Backend Environment Variables
# ==========================================

# Database URL
# For SQLite (default development):
DATABASE_URL=sqlite+aiosqlite:///./test.db

# For PostgreSQL (Docker/Production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cpcuration

# Secret key used for signing JWT tokens
# Generate a secure random key in production (e.g., run `openssl rand -hex 32`)
SECRET_KEY=algovault-dev-secret-key-change-in-production-2024

# CORS Allowed Origins (comma separated list of additional domains)
# CORS_ORIGINS=https://your-custom-frontend-domain.com,http://localhost:3000
